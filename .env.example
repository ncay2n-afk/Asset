# GEMINI_API_KEY: Required for Gemini AI API calls if AI features are added.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_CLOUD_BRIDGE_URL: Optional preconfigured Google Apps Script Web App (/exec) URL
# so every device automatically connects to the active Spreadsheet & Drive without Google login.
VITE_CLOUD_BRIDGE_URL=""

# VITE_CLOUD_BRIDGE_KEY: Optional secret access key matching ACCESS_KEY inside Code.gs.
VITE_CLOUD_BRIDGE_KEY=""
